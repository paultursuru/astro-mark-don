{
  "name": "astro-mark-don",
  "version": "0.2.0",
  "description": "Astro integration that generates a .md version of every page and an optional llms.txt at build time, optimized for LLM crawlers.",
  "type": "module",
  "main": "index.mjs",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.mjs"
    }
  },
  "types": "index.d.ts",
  "files": [
    "index.mjs",
    "index.d.ts"
  ],
  "scripts": {
    "test": "node --test"
  },
  "keywords": [
    "astro",
    "astro-integration",
    "markdown",
    "llm",
    "llms.txt",
    "seo",
    "static-site"
  ],
  "author": "Paul Lahana <paul.lahana@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/paultursuru/astro-mark-don"
  },
  "homepage": "https://github.com/paultursuru/astro-mark-don#readme",
  "bugs": {
    "url": "https://github.com/paultursuru/astro-mark-don/issues"
  },
  "peerDependencies": {
    "astro": "^4.0.0 || ^5.0.0 || ^6.0.0"
  },
  "dependencies": {
    "@mixmark-io/domino": "^2.2.0",
    "turndown": "^7.2.4"
  }
}
